{
	"name": "semantic-release-ai-notes",
	"version": "0.4.0",
	"description": "AI-powered release notes for semantic-release",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"build:action": "bun build action/index.ts --outfile dist/action/index.mjs --target node",
		"build:all": "pnpm build && pnpm build:action",
		"prebuild": "rm -rf dist/lib dist/index.js dist/index.d.ts dist/types.js dist/types.d.ts",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate": "pnpm lint && pnpm typecheck && pnpm build:all && bun test"
	},
	"keywords": [
		"semantic-release",
		"release-notes",
		"ai",
		"claude",
		"anthropic",
		"changelog"
	],
	"author": "Caio Pizzol",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caiopizzol/semantic-release-ai-notes.git"
	},
	"homepage": "https://github.com/caiopizzol/semantic-release-ai-notes",
	"bugs": "https://github.com/caiopizzol/semantic-release-ai-notes/issues",
	"peerDependencies": {
		"semantic-release": ">=20.0.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.81",
		"@semantic-release/error": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@types/bun": "^1.3.11",
		"@types/node": "^22.0.0",
		"lefthook": "^2.1.4",
		"semantic-release": "^25.0.3",
		"semantic-release-ai-notes": "^0.3.1",
		"typescript": "^5.7.0"
	},
	"files": [
		"dist"
	]
}
