{
	"name": "semantic-release-ai-notes",
	"version": "0.0.0",
	"description": "AI-powered release notes for semantic-release",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "./node_modules/.bin/tsc",
		"clean": "rm -rf dist",
		"prebuild": "rm -rf dist",
		"prepublishOnly": "npm run build",
		"typecheck": "./node_modules/.bin/tsc --noEmit",
		"test": "bun test",
		"lint": "./node_modules/.bin/biome check .",
		"lint:fix": "./node_modules/.bin/biome check --write .",
		"validate": "bun run lint && bun run typecheck && bun run build && bun test"
	},
	"keywords": [
		"semantic-release",
		"release-notes",
		"ai",
		"claude",
		"anthropic",
		"changelog"
	],
	"author": "Caio Pizzol",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caiopizzol/semantic-release-ai-notes.git"
	},
	"homepage": "https://github.com/caiopizzol/semantic-release-ai-notes",
	"bugs": "https://github.com/caiopizzol/semantic-release-ai-notes/issues",
	"peerDependencies": {
		"semantic-release": ">=20.0.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.81",
		"@semantic-release/error": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@types/node": "^22.0.0",
		"bun-types": "^1.3.11",
		"lefthook": "^2.1.4",
		"semantic-release": "^25.0.3",
		"typescript": "^5.7.0"
	},
	"files": [
		"dist"
	]
}