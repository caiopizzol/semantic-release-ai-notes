{
	"branches": ["main"],
	"plugins": [
		"@semantic-release/commit-analyzer",
		["semantic-release-ai-notes", { "model": "claude-sonnet-4-6", "style": "concise" }],
		["@semantic-release/npm", { "access": "public" }],
		["@semantic-release/git", {
			"assets": ["package.json"],
			"message": "chore(release): ${nextRelease.version}"
		}],
		"@semantic-release/github"
	]
}
